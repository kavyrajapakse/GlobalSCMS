# GlobalSCM Enterprise Environment Configuration Template
# Copy this file to .env and set your production or local development credentials

# -------------------------------------------------------------
# 1. Google Cloud / Gmail SMTP TLS Onboarding Credentials
# -------------------------------------------------------------
SCM_SMTP_USER=your-email@gmail.com
SCM_SMTP_PASS=your-16-digit-google-app-password

# -------------------------------------------------------------
# 2. Database Connection Parameters (Payara JDBC Pool)
# -------------------------------------------------------------
SCM_DB_HOST=localhost
SCM_DB_PORT=3306
SCM_DB_NAME=global_scm_db
SCM_DB_USER=root
SCM_DB_PASS=root

# -------------------------------------------------------------
# 3. JWT Security Secret
# -------------------------------------------------------------
SCM_JWT_SECRET=GlobalSCMSecureSecretKeyForHMAC256AuthenticationEngine2026!
